# --- app ---
INSTRUCTOR_SECRET=change-me
CONTENT_DIR=./content
ALLOW_DRAFT_CASES=true
GLASS_BOX_LIVE=false
LOG_RETENTION_DAYS=30
CORS_ORIGINS=http://localhost:3000

# --- web (public, baked in at build time; must contain no secrets) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
