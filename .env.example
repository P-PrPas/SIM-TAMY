# `cp .env.example .env` (never commit .env). Empty value = unset. Full list: docs/PRD.md section 6.5.

# --- Database ---
DB_PORT=5432                  # host port for the docker compose db
DATABASE_URL=postgresql+psycopg://sim:sim@localhost:5432/simtamy

# --- LLM ---
LLM_PROVIDER=mock             # mock (offline, deterministic) | openai_like
LLM_API_KEY=                  # server-side only
LLM_TIMEOUT_S=15
ACTION_ACCEPT_THRESHOLD=0.75     # confidence at or above this accepts an Action
ACTION_CLARIFY_THRESHOLD=0.5      # lower bound for clarification; must be below accept
LLM_MODEL_INTERPRETER=        # e.g. glm-5.3
LLM_MODEL_GENERATOR=
LLM_MODEL_DEBRIEF=

# openai_like only. Z.ai GLM: use the general API, not the Coding Plan endpoint (/api/coding/...).
LLM_BASE_URL=                 # https://api.z.ai/api/paas/v4
LLM_REASONING_EFFORT=         # GLM-5.3: low | high | max (provider default is max, slow)

# mock only
MOCK_LLM_SCRIPT=              # optional YAML script (PRD appendix A)

# --- App ---
INSTRUCTOR_SECRET=change-me
CONTENT_DIR=./content
ALLOW_DRAFT_CASES=true
GLASS_BOX_LIVE=false
LOG_RETENTION_DAYS=30
CORS_ORIGINS=http://localhost:3000   # comma-separated web origins
CORS_ORIGIN_REGEX=             # optional, whole-origin match (Vercel previews)

# --- Web (public, baked into the build: no secrets) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
