# Copy to .env. Never commit real keys. Full list: docs PRD section 6.5.

# --- database ---
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://sim:sim@localhost:5432/simtamy

# --- LLM (mock = offline + deterministic; keep it for tests) ---
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL_INTERPRETER=
LLM_MODEL_GENERATOR=
LLM_MODEL_DEBRIEF=
LLM_TIMEOUT_S=15

# Real provider (LLM_PROVIDER=openai_like), e.g. Z.ai GLM per docs.z.ai API reference.
# Use the general API endpoint below with a pay-as-you-go API key. The "GLM Coding Plan" key/endpoint
# (/api/coding/paas/v4) is limited by Z.ai to supported coding tools, not to your own backend.
# LLM_BASE_URL=https://api.z.ai/api/paas/v4
# LLM_MODEL_INTERPRETER=glm-5.3     # GLM-5.3 always "thinks"; start low to keep latency down
# LLM_REASONING_EFFORT=low          # GLM-5.3 accepts low|high|max (default max)

# Mock provider: optional YAML script (see PRD appendix A). Unset = built-in defaults.
# MOCK_LLM_SCRIPT=apps/api/tests/fixtures/mock_script_T01.yaml

# --- app ---
INSTRUCTOR_SECRET=change-me
CONTENT_DIR=./content
ALLOW_DRAFT_CASES=true
GLASS_BOX_LIVE=false
LOG_RETENTION_DAYS=30
CORS_ORIGINS=http://localhost:3000

# --- web (public, baked in at build time; must contain no secrets) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
