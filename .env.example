# `cp .env.example .env` (never commit .env). Empty value = unset. Full list: docs/PRD.md section 6.5.

# --- Database ---
# host port for the docker compose db
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://sim:sim@localhost:5432/simtamy

# --- LLM ---
# mock (offline, deterministic) | openai_like
LLM_PROVIDER=mock
# server-side only
LLM_API_KEY=
LLM_TIMEOUT_S=15
# confidence at or above this accepts an Action
ACTION_ACCEPT_THRESHOLD=0.75
# lower bound for clarification; must be below accept
ACTION_CLARIFY_THRESHOLD=0.5
# e.g. glm-5.3
LLM_MODEL_INTERPRETER=
LLM_MODEL_GENERATOR=
LLM_MODEL_DEBRIEF=

# openai_like only. Z.ai GLM: use the general API, not the Coding Plan endpoint (/api/coding/...).
# https://api.z.ai/api/paas/v4
LLM_BASE_URL=
# GLM-5.3: low | high | max (provider default is max, slow)
LLM_REASONING_EFFORT=

# mock only
# optional YAML script (PRD appendix A)
MOCK_LLM_SCRIPT=

# --- App ---
INSTRUCTOR_SECRET=change-me
CONTENT_DIR=./content
ALLOW_DRAFT_CASES=true
GLASS_BOX_LIVE=false
# true exposes static, synthetic recording snapshots
ENABLE_REPLAY=true
# optional; defaults to repo recordings/ locally
RECORDINGS_DIR=
LOG_RETENTION_DAYS=30
# sendTurn requests per minute per session (429 RATE_LIMITED); 0 turns it off
RATE_LIMIT_PER_MIN=10
# comma-separated web origins
CORS_ORIGINS=http://localhost:3000
# optional, whole-origin match (Vercel previews)
CORS_ORIGIN_REGEX=

# --- Web (public, baked into the build: no secrets) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
